ACCESS_TOKEN=replace-with-a-random-secret-at-least-32-characters
SOURCE_AUTHORIZATION=
SYNC_INTERVAL_SECONDS=300

# Optional PW OAuth client configuration; use values for your PW client.
PW_CLIENT_ID=system-admin
PW_CLIENT_SECRET=

# Optional: PW-compatible CAPTCHA site key that authorizes your domain.
# An unrelated Turnstile key will not enable PW login. Leave blank otherwise.
PW_CAPTCHA_SITE_KEY=

# Optional interactive PW browser (requires Playwright Chromium and Xvfb).
PW_BROWSER_ENABLED=false
# Example Ubuntu snap browser path:
# PW_BROWSER_EXECUTABLE=/snap/bin/chromium
